{
  "mcpServers": {
    "vps": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}",
        "python",
        "${CLAUDE_PROJECT_DIR:-.}/tools/run_project_mcp_server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "UV_NO_PROGRESS": "1",
        "UV_LINK_MODE": "copy"
      },
      "timeout": 600000,
      "alwaysLoad": true
    }
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__vps__get_server_context",
      "mcp__vps__get_monitoring_profile",
      "mcp__vps__run_monitoring",
      "mcp__vps__get_latest_report",
      "mcp__vps__get_report",
      "mcp__vps__find_exact_report_match",
      "mcp__vps__get_top_similar_reports",
      "mcp__vps__analyze_report",
      "mcp__vps__get_analysis",
      "mcp__vps__start_investigation",
      "mcp__vps__get_investigation",
      "mcp__vps__get_investigation_status",
      "mcp__vps__get_evidence",
      "mcp__vps__get_available_specialists",
      "mcp__vps__get_specialist_definition",
      "mcp__vps__run_specialist",
      "mcp__vps__propose_remediation",
      "mcp__vps__create_remediation_plan",
      "mcp__vps__test_remediation_in_sandbox",
      "mcp__vps__request_user_approval",
      "mcp__vps__apply_approved_remediation",
      "mcp__vps__attempt_autonomous_remediation",
      "Agent(specialist-worker)"
    ],
    "deny": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Bash(kubectl *)",
      "Bash(docker exec *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(sftp *)",
      "PowerShell(psql *)",
      "PowerShell(mysql *)",
      "PowerShell(kubectl *)",
      "PowerShell(docker exec *)",
      "mcp__vps__raw_ssh",
      "mcp__vps__raw_shell",
      "mcp__vps__execute_command",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "disableSkillShellExecution": true,
  "env": {
    "AI_VPS_LLM_PROVIDER": "ollama"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude_hooks/runtime_hooks.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude_hooks/runtime_hooks.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude_hooks/runtime_hooks.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "specialist-worker",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude_hooks/runtime_hooks.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "specialist-worker",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude_hooks/runtime_hooks.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude_hooks/runtime_hooks.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "vps"
  ],
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  }
}
